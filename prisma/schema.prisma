generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Bảng lưu trữ các khoản ủng hộ từ nhà hảo tâm (Qua ngân hàng BIDV 8630100930 & Casso)
model Donation {
  id              Int       @id @default(autoincrement())
  transactionId   String    @unique // Mã giao dịch định danh từ Casso / BIDV (chống trùng lặp)
  donorName       String    // Tên người gửi / nhà hảo tâm
  amount          Decimal   @db.Decimal(18, 2) // Số tiền ủng hộ (VNĐ)
  description     String    // Nội dung chuyển khoản
  transactionDate DateTime  @default(now()) // Ngày giờ giao dịch phát sinh
  status          String    @default("COMPLETED") // COMPLETED, PENDING, CANCELLED
  campaignId      Int?      // Khóa ngoại liên kết chiến dịch (nếu có)
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([transactionDate])
  @@index([status])
  @@index([donorName])
}

// 2. Bảng quản lý các chiến dịch vận động an sinh xã hội
model Campaign {
  id            Int        @id @default(autoincrement())
  title         String     // Tên cuộc vận động (VD: Xây nhà Đại đoàn kết, Bò giống sinh kế)
  targetAmount  Decimal    @db.Decimal(18, 2) // Mục tiêu vận động (VNĐ)
  currentAmount Decimal    @default(0) @db.Decimal(18, 2) // Số tiền hiện có đã vận động
  status        String     @default("ACTIVE") // ACTIVE, COMPLETED, CLOSED
  description   String?    // Mô tả chi tiết chiến dịch
  donations     Donation[] // Danh sách các khoản quyên góp vào chiến dịch này
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
}

// 3. Bảng quản lý các đợt giải ngân cho hộ nghèo tại 20 thôn buôn xã Ea Súp
model Disbursement {
  id            Int      @id @default(autoincrement())
  recipientName String   // Tên hộ nghèo / gia đình chính sách được thụ hưởng
  village       String   // Thuộc 1 trong 20 thôn buôn xã Ea Súp
  amount        Decimal  @db.Decimal(18, 2) // Số tiền hỗ trợ (VNĐ)
  proofImageUrl String?  // Đường dẫn ảnh chứng từ scan mộc đỏ / hóa đơn VAT
  date          DateTime @default(now()) // Ngày trao quà / chi hỗ trợ
  notes         String?  // Ghi chú chi tiết (VD: Hỗ trợ đợt 1 khởi công, trao tiền mặt...)
  createdAt     DateTime @default(now())

  @@index([village])
  @@index([date])
}

